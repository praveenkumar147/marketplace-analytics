# --- Secrets: never commit ---
.env
*.env
!.env.example

# --- Data: raw dataset is downloaded from Kaggle (CC BY-NC-SA 4.0), not redistributed ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/powerbi/

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# --- Power BI ---
*.pbix.bak
# PBIP: data cache (holds a full copy of the imported data) and machine-specific settings
**/.pbi/cache.abf
**/.pbi/localSettings.json
# Local safety copies of report files (contain data, not redistributed)
powerbi/backups/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
